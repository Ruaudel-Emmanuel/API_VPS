# 📌 Exemple de fichier .env pour API-VPS
# Copiez ce fichier en .env et modifiez les valeurs selon votre configuration.

# --- JWT (Authentification) ---
# Clé secrète pour signer les JWT (générez-en une avec `openssl rand -hex 32`)
JWT_SECRET=vps-gateway-secret-2026-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# --- Base de Données ---
# URL de connexion à PostgreSQL (format: postgresql://user:password@host:port/dbname)
DB_URL=postgresql://n8n:n8n@n8n_db:5432/n8n_db

# --- Réseau ---
# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost,https://n8n.rennesdev.fr

# --- Monitoring (Optionnel) ---
# Mot de passe admin pour Grafana
GRAFANA_ADMIN_PASSWORD=GrafanaAdmin2026!

# --- Tailscale ---
# IP Tailscale du VPS (pour lier les ports)
TAILSCALE_IP=100.75.226.13

# --- API Gateway ---
# Port de l'API Gateway
API_PORT=8000
